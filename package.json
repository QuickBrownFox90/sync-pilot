{
  "name": "sync-pilot",
  "private": true,
  "description": "Build, style check and browser tests of the SyncPilot admin assets: asset/src -> asset/css and asset/js",
  "scripts": {
    "build": "node asset/src/build.mjs",
    "dev": "node asset/src/build.mjs --watch",
    "test:browser": "node tests/browser/smoke.mjs",
    "test:controls": "node tests/browser/controls.mjs",
    "test:connection": "node tests/browser/connection.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release:check": "node tests/release-check.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "esbuild": "0.25.5",
    "eslint": "9.39.5"
  }
}
