msgstr "Fehler beim Deserialisieren der Anhangsdaten von der Remote-Website"

#: class/syncpilot-media-files.php:502
msgid "Determining which media files to migrate, please wait..."
msgstr "Zu migrierende Mediendateien werden ermittelt, bitte warten..."

#: class/syncpilot-media-files.php:503
msgid "Error while attempting to determine which media files to migrate."
msgstr "Fehler beim Ermitteln der zu migrierenden Mediendateien."

#: class/syncpilot-media-files.php:504 class/syncpilot.php:2475
msgid "Migration failed"
msgstr "Migration fehlgeschlagen"

#: class/syncpilot-media-files.php:505
msgid "A problem occurred when migrating the media files."
msgstr "Beim Migrieren der Mediendateien ist ein Problem aufgetreten."

#: class/syncpilot-media-files.php:506 template/media-files-options.php:5
msgid "Media Files"
msgstr "Mediendateien"

#: class/syncpilot-media-files.php:507
msgid "Migrating media files"
msgstr "Mediendateien werden migriert"

#: class/syncpilot-media-files.php:559
msgid "Invalid URL Provided."
msgstr ""

#: class/syncpilot-media-files.php:563
msgid "Could not create Temporary file."
msgstr ""

#: class/syncpilot-media-files.php:620
msgid "SyncPilot does not seems to be installed/active on the remote website."
msgstr ""
"SyncPilot scheint auf der Remote-Website nicht installiert/aktiv zu sein."

#: class/syncpilot.php:313 class/syncpilot.php:1484
msgid "Settings"
msgstr "Einstellungen"

#: class/syncpilot.php:374
msgid "ext/mysqli"
msgstr "ext/mysqli"

#: class/syncpilot.php:378
msgid "WP Memory Limit"
msgstr "WP Memory-Limit"

